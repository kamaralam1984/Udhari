# ---------------------------------------------------------------------------
# AI Voice Calling + Credit/Collection Automation — per-client deployment
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Business branding — shown on login/nav and spoken by the AI greeting.
# Also editable later from the Settings page (AppSettings.businessName).
BUSINESS_NAME="Your Business"
BUSINESS_TAGLINE=""

# Database
DATABASE_URL="postgresql://aicall:aicall_dev_pw_2026@localhost:5434/maa_chandrakala"

# Auth
AUTH_JWT_SECRET="change-me-to-a-long-random-string"
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL="owner@maachandrakala.local"
SEED_OWNER_PASSWORD="change-me-strong-password"

# Global safety switch. Calls can only be placed to real numbers when this is
# PRODUCTION *and* the call request explicitly asks for production mode.
APP_MODE="TEST"
TIMEZONE="Asia/Kolkata"

# server.ts (custom server, needed for the real-call audio bridge)
PORT="3000"

# --- Provider selection (provider-independent architecture) ---------------
# Each *_PROVIDER variable selects an implementation by name. "mock" always
# works with no external account. Swapping to a real vendor never requires
# code changes — only these env vars.

TELEPHONY_PROVIDER="mock"        # mock | twilio | exotel | plivo ...
TELEPHONY_API_KEY=""             # Twilio: Account SID  |  Exotel: API Key
TELEPHONY_API_SECRET=""          # Twilio: Auth Token    |  Exotel: API Token
TELEPHONY_FROM_NUMBER=""         # Twilio/Exotel phone number (Exophone) to call from
TELEPHONY_WEBHOOK_BASE_URL=""    # public base URL — status callback + WSS host, e.g. https://calls.example.com

# Twilio-specific (no dashboard flow needed — TwiML is generated inline per call):
TWILIO_WEBHOOK_SECRET=""            # shared-secret checked by /api/webhooks/twilio/status

# Exotel-specific (needs a pre-built App Bazaar flow — see README):
EXOTEL_ACCOUNT_SID=""
EXOTEL_SUBDOMAIN="api.exotel.com"   # region-dependent, verify at setup
EXOTEL_FLOW_APP_ID=""               # App Bazaar flow containing the Voicebot Applet
EXOTEL_WEBHOOK_SECRET=""            # shared-secret checked by /api/webhooks/exotel/status

STT_PROVIDER="mock"              # mock | bhashini | openai | deepgram | google ...
STT_API_KEY=""                   # for STT_PROVIDER="openai": falls back to LLM_API_KEY if unset (same OpenAI account)
OPENAI_STT_MODEL="whisper-1"     # OpenAI Whisper model — Hindi is officially supported, Magahi/Maithili are NOT
                                  # documented (may still work to some degree given Whisper's broad multilingual
                                  # training — unconfirmed, test via Language Lab's audio-upload before relying on it)
                                  # For lower per-turn latency, if your OpenAI account has access, try
                                  # "gpt-4o-mini-transcribe" instead — no other code change needed.

LLM_PROVIDER="mock"              # mock | openai | ...
LLM_API_KEY=""                   # OpenAI: API key (platform.openai.com)
LLM_MODEL=""                     # OpenAI: e.g. "gpt-4o-mini"

TTS_PROVIDER="mock"              # mock | bhashini | openai | elevenlabs | google | azure ...
TTS_API_KEY=""                   # for TTS_PROVIDER="openai": falls back to LLM_API_KEY if unset
TTS_VOICE_ID=""                  # for TTS_PROVIDER="openai": voice name, e.g. "alloy" (default), "nova", "shimmer" ...
OPENAI_TTS_MODEL="tts-1"         # already the low-latency model (not "tts-1-hd", which is slower/higher-quality).
                                  # For even lower latency, if your account has access, try "gpt-4o-mini-tts".

# Bhashini (bhashini.gov.in) uses a two-key ULCA auth shape that doesn't fit
# the single STT_API_KEY/TTS_API_KEY vars above, so it gets its own block:
BHASHINI_USER_ID=""
BHASHINI_ULCA_API_KEY=""
BHASHINI_PIPELINE_ID=""
BHASHINI_LANGUAGE_CODE="hi"      # safe default — Magahi/Bhojpuri/Maithili coverage on Bhashini is unconfirmed, see README
BHASHINI_MAGAHI_SUPPORTED="false" # set to "true" ONLY after confirming Bhashini has a Magahi ("mag") ASR/TTS model for BHASHINI_PIPELINE_ID — see src/lib/providers/bhashiniPipeline.ts

CUSTOM_VOICE_PROVIDER="none"     # none | mock | elevenlabs | resemble ...
CUSTOM_VOICE_API_KEY=""
CUSTOM_VOICE_ID=""

# WhatsApp/SMS — customer bill/reminders and the owner's WhatsApp AI-call
# report. Mock-first, same posture as Bhashini: no vendor picked yet, ships
# on the mock provider until a real WhatsApp Business API / SMS gateway
# account is chosen and approved. See src/lib/providers/whatsapp/ and sms/.
WHATSAPP_PROVIDER="mock"         # mock | <vendor tbd — decide once a WhatsApp Business API account is approved>
WHATSAPP_API_KEY=""
WHATSAPP_FROM_NUMBER=""
SMS_PROVIDER="mock"              # mock | <vendor tbd>
SMS_API_KEY=""
SMS_SENDER_ID=""
CUSTOM_VOICE_CONSENT_ON_FILE="false"

# --- Anti-spam / safety defaults (overridable from Settings screen) -------
ANTI_SPAM_MIN_GAP_HOURS="24"
ANTI_SPAM_MAX_ATTEMPTS_PER_DAY="1"
ANTI_SPAM_MAX_ATTEMPTS_PER_PROMISE="3"
ANTI_SPAM_QUIET_HOURS_START="21"
ANTI_SPAM_QUIET_HOURS_END="9"

# --- Notifications (dashboard active now; WhatsApp/SMS are stubs) ---------
NOTIFICATION_CHANNELS="dashboard"   # comma separated: dashboard,whatsapp_stub,sms_stub
